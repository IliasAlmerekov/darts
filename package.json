{
  "name": "darts",
  "version": "0.1.3",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fujiui/react": "^0.5.0",
    "@nanostores/react": "^0.8.4",
    "@tanstack/react-query": "^5.104.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "nanostores": "^0.11.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "valibot": "^1.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prettier:check": "prettier --check .",
    "eslint": "eslint ./src ./tests playwright.config.ts",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.eslint.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:red-on-base": "node ./scripts/red-on-base.mjs",
    "test:e2e": "playwright test --project=mocked",
    "test:e2e:live": "playwright test --project=live",
    "secrets:check": "node ./scripts/check-secrets.mjs",
    "validate:push": "npm run build && npm run eslint && npm run stylelint && npm run prettier:check && npm run typecheck && npm run knip && npm run secrets:check && npm run test",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "knip": "knip"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "knip": "^6.41.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.9.10",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "5.8",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
